# Copy to .env and fill in. Never commit .env.

# CourtListener REST token (Account > API tokens). Used only by hooks for the usage check; the MCP connector handles research calls.
COURTLISTENER_API_TOKEN=

# api.data.gov key: serves GovInfo and Regulations.gov. Sign up at https://www.govinfo.gov/api-signup
DATA_GOV_API_KEY=

# Congress.gov key. Sign up at https://api.congress.gov/sign-up/
CONGRESS_GOV_API_KEY=

# LegiScan key (already used by the local LegiScan MCP)
LEGISCAN_API_KEY=

# Optional
LEGAL_DATA_HUNTER_API_KEY=

# Matter path for uslaw-mcp to save sources into (set per session)
ALR_MATTER=
